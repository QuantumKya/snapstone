	(text "I'm pretty sure this works.\nTook me a while, but I\nfound a very helpful TI PDF\ndetailling some circuits.\n\n-Rohan"
		(exclude_from_sim no)
		(at 102.87 53.086 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left top)
		)
		(uuid "48386dc8-c58f-4242-9eac-a33c2a3574b2")
	)
	(text "CURRENT RESET"
		(exclude_from_sim no)
		(at 85.852 76.708 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "55499ad1-d4e6-41ac-aa93-b0c53166aef4")
	)
	(text "Rshunt = 10 Ω\n\ndV = (5 mA) * (10 Ω)\ndV = 50 mV\n\nVOUT = (R2/R1) * dV\nVOUT = (R2/R1) * (50 mV)\n\nCut-off voltage for MMBFJ270\nis 500 mV, so VOUT = 500 mV.\n500 mV = (R2/R1) * (50 mV)\nR2/R1 = 10.\n\nWe need to be careful that dV\nis high enough for our comparator\n(too low will require more precision)."
		(exclude_from_sim no)
		(at 107.442 104.14 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "8f1c1cb8-e072-4684-b083-f72c5b8b13fe")
	)
	(text "DELAY SWITCH THING"
